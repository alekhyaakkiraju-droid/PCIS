# OIDC / Keycloak configuration — copy to .env.local and fill in your values
VITE_OIDC_AUTHORITY=https://idp.pcis.example.com/realms/pcis
VITE_OIDC_CLIENT_ID=pcis-spa
VITE_OIDC_REDIRECT_URI=https://app.pcis.example.com/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://app.pcis.example.com
VITE_OIDC_SCOPE=openid profile email roles
