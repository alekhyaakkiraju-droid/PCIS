/* PCIS_CRTOBJ - Create Program Objects for PCIS                      */
/* Purpose: Compile and bind all PCIS programs, create display files, */
/*          create printer files, and submit scheduler jobs.          */
/* NOTE: JOBSCHD1-3 are runtime-only — no source in repository.       */
/*       JOBSCHD4-7 are defined in JOBSCHD_NEW_DRIVERS.clle.          */
/*       Printer files POLPOLP1/CLMPAYP1/RPT001P1/RPT006P1 missing.   */
PGM

DCL VAR(&SRCLIB)  TYPE(*CHAR) LEN(10) VALUE('PCIS')
DCL VAR(&PGMLIB)  TYPE(*CHAR) LEN(10) VALUE('PCISPGM')
DCL VAR(&DSPLIB)  TYPE(*CHAR) LEN(10) VALUE('PCISPGM')
DCL VAR(&ERRFLAG) TYPE(*LGL)          VALUE('0')

/* ------------------------------------------------------------------ */
/* Compile COBOL programs                                              */
/* ------------------------------------------------------------------ */
CRTSQLCBLI OBJ(CLM006B) SRCFILE(PCIS/QCBLSRC) SRCMBR(CLM006B) +
  COMMIT(*NONE) CLOSQLCSR(*ENDMOD) OPTION(*EVENTF)
CRTPGM PGM(CLM006B) MODULE(CLM006B) BNDDIR(*LIBL/PCISBND)

CRTSQLCBLI OBJ(CMM001B) SRCFILE(PCIS/QCBLSRC) SRCMBR(CMM001B) +
  COMMIT(*NONE) CLOSQLCSR(*ENDMOD)
CRTPGM PGM(CMM001B) MODULE(CMM001B) BNDDIR(*LIBL/PCISBND)

CRTSQLCBLI OBJ(POL001A) SRCFILE(PCIS/QCBLSRC) SRCMBR(POL001A) +
  COMMIT(*NONE) CLOSQLCSR(*ENDMOD)
CRTPGM PGM(POL001A) MODULE(POL001A) BNDDIR(*LIBL/PCISBND)

CRTSQLCBLI OBJ(POL006B) SRCFILE(PCIS/QCBLSRC) SRCMBR(POL006B) +
  COMMIT(*NONE) CLOSQLCSR(*ENDMOD)
CRTPGM PGM(POL006B) MODULE(POL006B) BNDDIR(*LIBL/PCISBND)

CRTSQLCBLI OBJ(PRM005B) SRCFILE(PCIS/QCBLSRC) SRCMBR(PRM005B) +
  COMMIT(*NONE) CLOSQLCSR(*ENDMOD)
CRTPGM PGM(PRM005B) MODULE(PRM005B) BNDDIR(*LIBL/PCISBND)

CRTSQLCBLI OBJ(BIL003B) SRCFILE(PCIS/QCBLSRC) SRCMBR(BIL003B) +
  COMMIT(*NONE) CLOSQLCSR(*ENDMOD)
CRTPGM PGM(BIL003B) MODULE(BIL003B) BNDDIR(*LIBL/PCISBND)

CRTSQLCBLI OBJ(AUD002B) SRCFILE(PCIS/QCBLSRC) SRCMBR(AUD002B) +
  COMMIT(*NONE) CLOSQLCSR(*ENDMOD)
CRTPGM PGM(AUD002B) MODULE(AUD002B) BNDDIR(*LIBL/PCISBND)

CRTSQLCBLI OBJ(CUS001A) SRCFILE(PCIS/QCBLSRC) SRCMBR(CUS001A) +
  COMMIT(*NONE) CLOSQLCSR(*ENDMOD)
CRTPGM PGM(CUS001A) MODULE(CUS001A) BNDDIR(*LIBL/PCISBND)

/* ------------------------------------------------------------------ */
/* Create display files                                                */
/* ------------------------------------------------------------------ */
CRTDSPF FILE(CLMFNLD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(CLMFNLD1)
CRTDSPF FILE(CLMRSVD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(CLMRSVD1)
CRTDSPF FILE(CLMADJD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(CLMADJD1)
CRTDSPF FILE(CLMINQD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(CLMINQD1)
CRTDSPF FILE(CLMCLSD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(CLMCLSD1)
CRTDSPF FILE(CLMAPRD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(CLMAPRD1)
CRTDSPF FILE(CLMPAYD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(CLMPAYD1)
CRTDSPF FILE(CUSMNTD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(CUSMNTD1)
CRTDSPF FILE(CUSINQD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(CUSINQD1)
CRTDSPF FILE(CUSLSTD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(CUSLSTD1)
CRTDSPF FILE(CUSDELD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(CUSDELD1)
CRTDSPF FILE(CUSCNTD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(CUSCNTD1)
CRTDSPF FILE(POLMNTD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(POLMNTD1)
CRTDSPF FILE(POLINQD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(POLINQD1)
CRTDSPF FILE(POLREND1) SRCFILE(PCIS/QDDSSRC) SRCMBR(POLREND1)
CRTDSPF FILE(POLLSTD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(POLLSTD1)
CRTDSPF FILE(POLENDD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(POLENDD1)
CRTDSPF FILE(PRMINQD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(PRMINQD1)
CRTDSPF FILE(BILSTSD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(BILSTSD1)
CRTDSPF FILE(COMRPTD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(COMRPTD1)
CRTDSPF FILE(RPTMNUD1) SRCFILE(PCIS/QDDSSRC) SRCMBR(RPTMNUD1)
CRTDSPF FILE(MENUMD1)  SRCFILE(PCIS/QDDSSRC) SRCMBR(MENUMD1)

/* ------------------------------------------------------------------ */
/* Create printer files (source members currently missing — G-08)     */
/* ------------------------------------------------------------------ */
CRTPRTF FILE(POLPOLP1) SRCFILE(PCIS/QDDSSRC) SRCMBR(POLPOLP1)
CRTPRTF FILE(CLMPAYP1) SRCFILE(PCIS/QDDSSRC) SRCMBR(CLMPAYP1)
CRTPRTF FILE(RPT001P1) SRCFILE(PCIS/QDDSSRC) SRCMBR(RPT001P1)
CRTPRTF FILE(RPT006P1) SRCFILE(PCIS/QDDSSRC) SRCMBR(RPT006P1)

/* ------------------------------------------------------------------ */
/* Submit scheduler jobs                                               */
/* JOBSCHD1-3: runtime-only objects; no source in repository (G-08)   */
/* ------------------------------------------------------------------ */
SBMJOB CMD(CALL PGM(JOBSCHD1)) JOB(JOBSCHD1) JOBQ(PCISQ)
SBMJOB CMD(CALL PGM(JOBSCHD2)) JOB(JOBSCHD2) JOBQ(PCISQ)
SBMJOB CMD(CALL PGM(JOBSCHD3)) JOB(JOBSCHD3) JOBQ(PCISQ)

ENDPGM
