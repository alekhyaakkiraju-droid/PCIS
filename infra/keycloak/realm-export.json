{
  "realm": "pcis",
  "enabled": true,
  "displayName": "PCIS",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>PCIS</span></div>",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,
  "ssoSessionIdleTimeoutRememberMe": 28800,
  "ssoSessionMaxLifespanRememberMe": 28800,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "clientSessionIdleTimeout": 3600,
  "clientSessionMaxLifespan": 3600,
  "clientOfflineSessionIdleTimeout": 0,
  "clientOfflineSessionMaxLifespan": 0,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "CLAIMS_ADJUSTER",
        "description": "Claims adjuster — payment authority bounded by authority_limit claim",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "CLAIMS_SUPERVISOR",
        "description": "Claims supervisor — oversight and elevated claim actions",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "CSR",
        "description": "Customer service representative",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "UNDERWRITER",
        "description": "Policy underwriter",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "FINANCE",
        "description": "Billing / finance clerk and reporting consumers",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "COMPLIANCE",
        "description": "Compliance officer / audit investigator",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "BATCH_SVC",
        "description": "Non-human batch / service workload identity",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "authority_limit"
  ],
  "defaultOptionalClientScopes": [
    "offline_access",
    "address",
    "phone",
    "microprofile-jwt"
  ],
  "clientScopes": [
    {
      "name": "authority_limit",
      "description": "Maps user attribute authority_limit into access tokens (absent when unset)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false",
        "consent.screen.text": ""
      },
      "protocolMappers": [
        {
          "name": "authority_limit",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "authority_limit",
            "claim.name": "authority_limit",
            "jsonType.label": "long",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "pcis-spa",
      "name": "PCIS React SPA",
      "description": "Public browser client — Authorization Code + PKCE (S256)",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3000/*",
        "https://app.dev.pcis.example.com/*",
        "https://app.tst.pcis.example.com/*",
        "https://app.pcis.example.com/*"
      ],
      "webOrigins": [
        "+",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##https://app.dev.pcis.example.com/*##https://app.tst.pcis.example.com/*##https://app.pcis.example.com/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "client_credentials.use_refresh_token": "false",
        "access.token.lifespan": "900"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "authority_limit"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "pcis-gateway",
      "name": "PCIS API Gateway",
      "description": "Confidential gateway client — auth code + token introspection",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "secret": "CHANGE_ME_GATEWAY_CLIENT_SECRET",
      "rootUrl": "http://localhost:8081",
      "redirectUris": [
        "http://localhost:8081/*",
        "https://api.dev.pcis.example.com/*",
        "https://api.tst.pcis.example.com/*",
        "https://api.pcis.example.com/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "900",
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "authority_limit"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "pcis-batch",
      "name": "PCIS Batch Workloads",
      "description": "Confidential client-credentials client with BATCH_SVC service account",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "secret": "CHANGE_ME_BATCH_CLIENT_SECRET",
      "attributes": {
        "access.token.lifespan": "3600",
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    }
  ],
